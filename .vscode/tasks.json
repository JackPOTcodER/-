{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g", // 启用调试信息
                "${file}", // 当前打开的cpp文件
                "-o", // 输出文件
                "${fileDirname}/${fileBasenameNoExtension}", // 输出路径和名字
                "-I/opt/Galaxy/include",
                "-L/opt/Galaxy/lib",
                "-lgxiapi"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译器: /usr/bin/g++"
        }
    ]
}